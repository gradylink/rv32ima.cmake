cmake_minimum_required(VERSION 3.13)

# usage: cmake -DIMAGE=Image [-DDTB=minimal.dtb] -P rv32ima.cmake

if(NOT DEFINED IMAGE)
  message(FATAL_ERROR "usage: cmake -DIMAGE=<kernel.bin> [-DDTB=<file.dtb>] -P rv32ima.cmake")
endif()
if(NOT DEFINED UART_FLUSH_AGE)
  set(UART_FLUSH_AGE 1000)
endif()

set(MMIO_LO 268435456)            # 0x10000000
set(MMIO_HI 301989888)            # 0x12000000
set(ADDR_UART 268435456)          # 0x10000000
set(ADDR_UART_LSR 268435461)      # 0x10000005
set(ADDR_CLNT_MATCH_LO 285229056) # 0x11004000
set(ADDR_CLNT_MATCH_HI 285229060) # 0x11004004
set(ADDR_TIMER_LO 285261816)      # 0x1100bff8
set(ADDR_TIMER_HI 285261820)      # 0x1100bffc
set(ADDR_SYSCON 286261248)        # 0x11100000

set(INT_MIN -2147483648)

set(RAM_SIZE 67108864)   # 64 MiB
set(RAM_BASE 2147483648) # 0x80000000
math(EXPR RAM_LAST_WORD "${RAM_SIZE} - 4")

set(CSR_MSTATUS 768)  # 0x300
set(CSR_MISA 769)     # 0x301
set(CSR_MIE 772)      # 0x304
set(CSR_MTVEC 773)    # 0x305
set(CSR_MSCRATCH 832) # 0x340
set(CSR_MEPC 833)     # 0x341
set(CSR_MCAUSE 834)   # 0x342
set(CSR_MTVAL 835)    # 0x343
set(CSR_MIP 836)      # 0x344
set(CSR_CYCLE 3072)   # 0xc00
set(CSR_TIME 3073)    # 0xc01
set(CSR_INSTRET 3074) # 0xc02
set(CSR_CYCLEH 3200)  # 0xc80
set(CSR_TIMEH 3201)   # 0xc81

set(PAGE_SHIFT 10)
set(PAGE_BYTES 1024)
math(EXPR PAGE_HEX "${PAGE_BYTES} * 2")
string(REPEAT "00" ${PAGE_BYTES} ZERO_PAGE)

function(load_file path start_page)
  set(_off 0)
  set(_p ${start_page})
  while(TRUE)
    file(READ "${path}" _chunk OFFSET ${_off} LIMIT ${PAGE_BYTES} HEX)
    string(LENGTH "${_chunk}" _cl)
    if(_cl EQUAL 0)
      break()
    endif()
    if(_cl LESS PAGE_HEX)
      math(EXPR _pad "${PAGE_HEX} - ${_cl}")
      string(SUBSTRING "${ZERO_PAGE}" 0 ${_pad} _z)
      string(APPEND _chunk "${_z}")
    endif()
    if(NOT _chunk STREQUAL ZERO_PAGE)
      set(PAGE_${_p} "${_chunk}" PARENT_SCOPE)
    endif()
    math(EXPR _off "${_off} + ${PAGE_BYTES}")
    math(EXPR _p "${_p} + 1")
  endwhile()
endfunction()

message(STATUS "Loading image")
set(IMAGE_ADDR ${RAM_BASE})
math(EXPR IMAGE_PAGE "(${IMAGE_ADDR} - ${RAM_BASE}) >> ${PAGE_SHIFT}")
load_file("${IMAGE}" ${IMAGE_PAGE})

set(DTB_ADDR 0)
if(DEFINED DTB AND NOT "${DTB}" STREQUAL "")
  message(STATUS "Loading DTB")
  file(READ "${DTB}" _dtb HEX)
  string(LENGTH "${_dtb}" _dtb_hexlen)
  math(EXPR DTB_LEN "${_dtb_hexlen} / 2")
  unset(_dtb)

  # end of RAM, page aligned (also satisfies Linux's 8-byte DTB alignment)
  math(EXPR DTB_OFF "(${RAM_SIZE} - ${DTB_LEN}) & ~(${PAGE_BYTES} - 1)")
  math(EXPR DTB_PAGE "${DTB_OFF} >> ${PAGE_SHIFT}")
  math(EXPR DTB_ADDR "${RAM_BASE} + ${DTB_OFF}")
  load_file("${DTB}" ${DTB_PAGE})
endif()

foreach(i RANGE 0 31)
  set(CPU_R${i} 0)
endforeach()
set(CPU_R10 0)           # a0 = hartid
set(CPU_R11 ${DTB_ADDR}) # a1 = pointer to DTB

set(CPU_PC ${IMAGE_ADDR})
set(CPU_PRIV 3)
set(CPU_MSTATUS 0)
set(CPU_MIE 0)
set(CPU_MIP 0)
set(CPU_MTVEC 0)
set(CPU_MSCRATCH 0)
set(CPU_MEPC 0)
set(CPU_MCAUSE 0)
set(CPU_MTVAL 0)
set(CPU_MTIME_LO 0)
set(CPU_MTIME_HI 0)
set(CPU_MTIME_CMP_LO 4294967295) # 0xffffffff
set(CPU_MTIME_CMP_HI 4294967295) # 0xffffffff
set(CPU_INSTRET 0)
set(CPU_HALTED FALSE)
set(CPU_RESERVATION 0)
set(CPU_HAS_RESERVATION FALSE)

set(UART_BUF "")
set(UART_PENDING FALSE)
set(UART_NL FALSE)
set(UART_AGE 0)

macro(to_s32 in out)
  if(${in} GREATER 2147483647)
    math(EXPR ${out} "${in} - 4294967296")
  else()
    set(${out} ${in})
  endif()
endmacro()

macro(sra32 v sh out)
  if(${v} GREATER 2147483647)
    math(EXPR ${out} "(${v} >> ${sh}) | (((1 << ${sh}) - 1) << (32 - ${sh}))")
  else()
    math(EXPR ${out} "${v} >> ${sh}")
  endif()
endmacro()

macro(mulhu a b out)
  math(EXPR _ma0 "${a} & 0xFFFF")
  math(EXPR _ma1 "${a} >> 16")
  math(EXPR _mb0 "${b} & 0xFFFF")
  math(EXPR _mb1 "${b} >> 16")
  math(EXPR _mt "${_ma1} * ${_mb0} + ((${_ma0} * ${_mb0}) >> 16)")
  math(EXPR _mw1 "(${_mt} & 0xFFFF) + ${_ma0} * ${_mb1}")
  math(EXPR ${out} "(${_ma1} * ${_mb1} + (${_mt} >> 16) + (${_mw1} >> 16)) & 0xFFFFFFFF")
endmacro()

macro(raise_trap cause tval)
  set(CPU_MEPC ${CPU_PC})
  math(EXPR CPU_MCAUSE "(${cause}) & 0xFFFFFFFF")
  math(EXPR CPU_MTVAL "(${tval}) & 0xFFFFFFFF")

  math(EXPR CPU_MSTATUS
    "(${CPU_MSTATUS} & ~((1 << 7) | (1 << 3) | (3 << 11))) | (((${CPU_MSTATUS} >> 3) & 1) << 7) | (${CPU_PRIV} << 11)")

  set(CPU_PRIV 3)
  math(EXPR CPU_PC "${CPU_MTVEC} & ~3")
endmacro()

macro(trap_break cause tval)
  raise_trap(${cause} ${tval})
  break()
endmacro()

macro(mem_read32 addr out)
  math(EXPR _o "${addr} - ${RAM_BASE}")
  math(EXPR _pg "${_o} >> ${PAGE_SHIFT}")
  math(EXPR _i "(${_o} & (${PAGE_BYTES} - 1)) * 2")
  if(DEFINED PAGE_${_pg})
    string(SUBSTRING "${PAGE_${_pg}}" ${_i} 8 _h)
    string(SUBSTRING "${_h}" 0 2 _b0)
    string(SUBSTRING "${_h}" 2 2 _b1)
    string(SUBSTRING "${_h}" 4 2 _b2)
    string(SUBSTRING "${_h}" 6 2 _b3)
    math(EXPR ${out} "0x${_b3}${_b2}${_b1}${_b0}")
  else()
    set(${out} 0)
  endif()
endmacro()

macro(ram_read_le off nbytes out)
  math(EXPR _pg "${off} >> ${PAGE_SHIFT}")
  math(EXPR _pi "(${off} & (${PAGE_BYTES} - 1)) * 2")
  math(EXPR _pe "${_pi} + ${nbytes} * 2")
  if(_pe LESS_EQUAL ${PAGE_HEX})
    if(DEFINED PAGE_${_pg})
      if(${nbytes} EQUAL 4)
        string(SUBSTRING "${PAGE_${_pg}}" ${_pi} 8 _ph)
        string(SUBSTRING "${_ph}" 0 2 _pb0)
        string(SUBSTRING "${_ph}" 2 2 _pb1)
        string(SUBSTRING "${_ph}" 4 2 _pb2)
        string(SUBSTRING "${_ph}" 6 2 _pb3)
        math(EXPR ${out} "0x${_pb3}${_pb2}${_pb1}${_pb0}")
      elseif(${nbytes} EQUAL 2)
        string(SUBSTRING "${PAGE_${_pg}}" ${_pi} 4 _ph)
        string(SUBSTRING "${_ph}" 0 2 _pb0)
        string(SUBSTRING "${_ph}" 2 2 _pb1)
        math(EXPR ${out} "0x${_pb1}${_pb0}")
      else()
        string(SUBSTRING "${PAGE_${_pg}}" ${_pi} 2 _ph)
        math(EXPR ${out} "0x${_ph}")
      endif()
    else()
      set(${out} 0)
    endif()
  else()
    set(_pacc 0)
    math(EXPR _plast "${nbytes} - 1")
    foreach(_pk RANGE 0 ${_plast})
      math(EXPR _pbo "${off} + ${_pk}")
      math(EXPR _pbp "${_pbo} >> ${PAGE_SHIFT}")
      math(EXPR _pbi "(${_pbo} & (${PAGE_BYTES} - 1)) * 2")
      if(DEFINED PAGE_${_pbp})
        string(SUBSTRING "${PAGE_${_pbp}}" ${_pbi} 2 _pbh)
      else()
        set(_pbh 00)
      endif()
      math(EXPR _pacc "${_pacc} | (0x${_pbh} << (8 * ${_pk}))")
    endforeach()
    set(${out} ${_pacc})
  endif()
endmacro()

macro(ram_put poff phex phexlen)
  math(EXPR _qg "${poff} >> ${PAGE_SHIFT}")
  math(EXPR _qi "(${poff} & (${PAGE_BYTES} - 1)) * 2")
  if(DEFINED PAGE_${_qg})
    set(_qpage "${PAGE_${_qg}}")
  else()
    set(_qpage "${ZERO_PAGE}")
  endif()
  string(SUBSTRING "${_qpage}" 0 ${_qi} _qhead)
  math(EXPR _qt "${_qi} + ${phexlen}")
  string(SUBSTRING "${_qpage}" ${_qt} -1 _qtail)
  set(PAGE_${_qg} "${_qhead}${phex}${_qtail}")
endmacro()

macro(ram_write_le woff wbytes wval)
  math(EXPR _whl "${wbytes} * 2")
  if(${wbytes} EQUAL 4)
    math(EXPR _wv "${wval} & 0xFFFFFFFF" OUTPUT_FORMAT HEXADECIMAL)
  elseif(${wbytes} EQUAL 2)
    math(EXPR _wv "${wval} & 0xFFFF" OUTPUT_FORMAT HEXADECIMAL)
  else()
    math(EXPR _wv "${wval} & 0xFF" OUTPUT_FORMAT HEXADECIMAL)
  endif()
  string(SUBSTRING "${_wv}" 2 -1 _wv)
  string(CONCAT _wp "00000000" "${_wv}")
  string(LENGTH "${_wp}" _wn)
  math(EXPR _ws "${_wn} - ${_whl}")
  string(SUBSTRING "${_wp}" ${_ws} ${_whl} _wd)

  if(${wbytes} EQUAL 4)
    string(SUBSTRING "${_wd}" 6 2 _wb0)
    string(SUBSTRING "${_wd}" 4 2 _wb1)
    string(SUBSTRING "${_wd}" 2 2 _wb2)
    string(SUBSTRING "${_wd}" 0 2 _wb3)
    set(_whx "${_wb0}${_wb1}${_wb2}${_wb3}")
  elseif(${wbytes} EQUAL 2)
    string(SUBSTRING "${_wd}" 2 2 _wb0)
    string(SUBSTRING "${_wd}" 0 2 _wb1)
    set(_whx "${_wb0}${_wb1}")
  else()
    set(_whx "${_wd}")
  endif()

  math(EXPR _we "(${woff} & (${PAGE_BYTES} - 1)) * 2 + ${_whl}")
  if(_we LESS_EQUAL ${PAGE_HEX})
    ram_put(${woff} ${_whx} ${_whl})
  else()
    math(EXPR _wlast "${wbytes} - 1")
    foreach(_wk RANGE 0 ${_wlast})
      math(EXPR _wko "${woff} + ${_wk}")
      math(EXPR _wkc "${_wk} * 2")
      string(SUBSTRING "${_whx}" ${_wkc} 2 _wkb)
      ram_put(${_wko} ${_wkb} 2)
    endforeach()
  endif()
endmacro()

macro(uart_putc b)
  if(NOT ${b} EQUAL 0)
    string(ASCII ${b} _uch)
    string(APPEND UART_BUF "${_uch}")
    set(UART_PENDING TRUE)
    if(${b} EQUAL 10)
      set(UART_NL TRUE)
    endif()
  endif()
endmacro()

macro(uart_flush)
  if(NOT "${UART_BUF}" STREQUAL "")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo_append "${UART_BUF}")
  endif()
  set(UART_BUF "")
  set(UART_PENDING FALSE)
  set(UART_NL FALSE)
  set(UART_AGE 0)
endmacro()

macro(mmio_load addr out)
  if(${addr} EQUAL ${ADDR_UART_LSR})
    set(${out} 96)
  elseif(${addr} EQUAL ${ADDR_TIMER_LO})
    set(${out} ${CPU_MTIME_LO})
  elseif(${addr} EQUAL ${ADDR_TIMER_HI})
    set(${out} ${CPU_MTIME_HI})
  else()
    set(${out} 0)
  endif()
endmacro()

macro(mmio_store addr val)
  if(${addr} EQUAL ${ADDR_UART})
    math(EXPR _ub "${val} & 0xFF")
    uart_putc(${_ub})
  elseif(${addr} EQUAL ${ADDR_CLNT_MATCH_LO})
    math(EXPR CPU_MTIME_CMP_LO "${val} & 0xFFFFFFFF")
  elseif(${addr} EQUAL ${ADDR_CLNT_MATCH_HI})
    math(EXPR CPU_MTIME_CMP_HI "${val} & 0xFFFFFFFF")
  elseif(${addr} EQUAL ${ADDR_SYSCON})
    set(CPU_HALTED TRUE)
  endif()
endmacro()

macro(mem_load addr width sgn out)
  if(${addr} GREATER_EQUAL ${MMIO_LO} AND ${addr} LESS ${MMIO_HI})
    mmio_load(${addr} _mv)
  else()
    math(EXPR _moff "${addr} - ${RAM_BASE}")
    math(EXPR _mbytes "1 << ${width}")
    math(EXPR _mend "${_moff} + ${_mbytes}")
    if(${_moff} LESS 0 OR ${_mend} GREATER ${RAM_SIZE})
      trap_break(5 ${addr})
    endif()
    ram_read_le(${_moff} ${_mbytes} _mv)
    if(${sgn})
      if(${width} EQUAL 0 AND ${_mv} GREATER 127)
        math(EXPR _mv "${_mv} + 4294967040")   # | 0xFFFFFF00
      elseif(${width} EQUAL 1 AND ${_mv} GREATER 32767)
        math(EXPR _mv "${_mv} + 4294901760")   # | 0xFFFF0000
      endif()
    endif()
  endif()
  set(${out} ${_mv})
endmacro()

macro(mem_store addr val width)
  if(${addr} GREATER_EQUAL ${MMIO_LO} AND ${addr} LESS ${MMIO_HI})
    mmio_store(${addr} ${val})
  else()
    math(EXPR _moff "${addr} - ${RAM_BASE}")
    math(EXPR _mbytes "1 << ${width}")
    math(EXPR _mend "${_moff} + ${_mbytes}")
    if(${_moff} LESS 0 OR ${_mend} GREATER ${RAM_SIZE})
      trap_break(7 ${addr})
    endif()
    ram_write_le(${_moff} ${_mbytes} ${val})
  endif()
endmacro()

macro(csr_read csr out)
  if(${csr} EQUAL ${CSR_MSTATUS})
    set(${out} ${CPU_MSTATUS})
  elseif(${csr} EQUAL ${CSR_MIE})
    set(${out} ${CPU_MIE})
  elseif(${csr} EQUAL ${CSR_MTVEC})
    set(${out} ${CPU_MTVEC})
  elseif(${csr} EQUAL ${CSR_MSCRATCH})
    set(${out} ${CPU_MSCRATCH})
  elseif(${csr} EQUAL ${CSR_MEPC})
    set(${out} ${CPU_MEPC})
  elseif(${csr} EQUAL ${CSR_MCAUSE})
    set(${out} ${CPU_MCAUSE})
  elseif(${csr} EQUAL ${CSR_MTVAL})
    set(${out} ${CPU_MTVAL})
  elseif(${csr} EQUAL ${CSR_MIP})
    set(${out} ${CPU_MIP})
  elseif(${csr} EQUAL ${CSR_MISA})
    set(${out} 1073746177)
  elseif(${csr} EQUAL ${CSR_CYCLE} OR ${csr} EQUAL ${CSR_TIME})
    set(${out} ${CPU_MTIME_LO})
  elseif(${csr} EQUAL ${CSR_CYCLEH} OR ${csr} EQUAL ${CSR_TIMEH})
    set(${out} ${CPU_MTIME_HI})
  elseif(${csr} EQUAL ${CSR_INSTRET})
    set(${out} ${CPU_INSTRET})
  else()
    set(${out} 0)
  endif()
endmacro()

macro(csr_write csr val)
  math(EXPR _cw "(${val}) & 0xFFFFFFFF")
  if(${csr} EQUAL ${CSR_MSTATUS})
    set(CPU_MSTATUS ${_cw})
  elseif(${csr} EQUAL ${CSR_MIE})
    set(CPU_MIE ${_cw})
  elseif(${csr} EQUAL ${CSR_MTVEC})
    set(CPU_MTVEC ${_cw})
  elseif(${csr} EQUAL ${CSR_MSCRATCH})
    set(CPU_MSCRATCH ${_cw})
  elseif(${csr} EQUAL ${CSR_MEPC})
    set(CPU_MEPC ${_cw})
  elseif(${csr} EQUAL ${CSR_MCAUSE})
    set(CPU_MCAUSE ${_cw})
  elseif(${csr} EQUAL ${CSR_MTVAL})
    set(CPU_MTVAL ${_cw})
  elseif(${csr} EQUAL ${CSR_MIP})
    set(CPU_MIP ${_cw})
  endif()
endmacro()

macro(wr_rd val)
  if(_rd)
    set(CPU_R${_rd} ${val})
  endif()
endmacro()

macro(dec_imm_i)
  math(EXPR _imm "${_insn} >> 20")
  if(_imm GREATER 2047)
    math(EXPR _imm "${_imm} - 4096")
  endif()
endmacro()

macro(cpu_step)
  foreach(_once RANGE 0 0)
    set(_pc ${CPU_PC})

    math(EXPR _foff "${_pc} - ${RAM_BASE}")
    math(EXPR _fal "${_pc} & 3")
    if(${_foff} LESS 0 OR ${_foff} GREATER ${RAM_LAST_WORD} OR NOT _fal EQUAL 0)
      trap_break(1 ${_pc})
    endif()
    mem_read32(${_pc} _insn)

    math(EXPR _opcode "${_insn} & 0x7f")
    math(EXPR _rd "(${_insn} >> 7) & 0x1f")
    math(EXPR _f3 "(${_insn} >> 12) & 0x7")
    math(EXPR _rs1 "(${_insn} >> 15) & 0x1f")
    math(EXPR _rs2 "(${_insn} >> 20) & 0x1f")
    math(EXPR _f7 "(${_insn} >> 25) & 0x7f")
    set(_r1 ${CPU_R${_rs1}})
    set(_r2 ${CPU_R${_rs2}})
    math(EXPR _next "(${_pc} + 4) & 0xFFFFFFFF")

    if(_opcode EQUAL 19) # 0x13 OP-IMM
      dec_imm_i()
      if(_f3 EQUAL 0)         # ADDI
        math(EXPR _res "(${_r1} + ${_imm}) & 0xFFFFFFFF")
      elseif(_f3 EQUAL 1)     # SLLI
        math(EXPR _res "(${_r1} << ${_rs2}) & 0xFFFFFFFF")
      elseif(_f3 EQUAL 2)     # SLTI
        to_s32(${_r1} _sa)
        if(${_sa} LESS ${_imm})
          set(_res 1)
        else()
          set(_res 0)
        endif()
      elseif(_f3 EQUAL 3)     # SLTIU
        math(EXPR _uimm "${_imm} & 0xFFFFFFFF")
        if(${_r1} LESS ${_uimm})
          set(_res 1)
        else()
          set(_res 0)
        endif()
      elseif(_f3 EQUAL 4)     # XORI
        math(EXPR _res "${_r1} ^ (${_imm} & 0xFFFFFFFF)")
      elseif(_f3 EQUAL 5)     # SRLI / SRAI
        math(EXPR _sra "(${_insn} >> 30) & 1")
        if(_sra EQUAL 0)
          math(EXPR _res "${_r1} >> ${_rs2}")
        else()
          sra32(${_r1} ${_rs2} _res)
        endif()
      elseif(_f3 EQUAL 6)     # ORI
        math(EXPR _res "${_r1} | (${_imm} & 0xFFFFFFFF)")
      else()                  # ANDI
        math(EXPR _res "${_r1} & (${_imm} & 0xFFFFFFFF)")
      endif()
      wr_rd(${_res})

    elseif(_opcode EQUAL 3) # 0x03 LOAD
      dec_imm_i()
      math(EXPR _addr "(${_r1} + ${_imm}) & 0xFFFFFFFF")
      if(_f3 EQUAL 0)
        mem_load(${_addr} 0 1 _val)   # LB
      elseif(_f3 EQUAL 1)
        mem_load(${_addr} 1 1 _val)   # LH
      elseif(_f3 EQUAL 2)
        mem_load(${_addr} 2 1 _val)   # LW
      elseif(_f3 EQUAL 4)
        mem_load(${_addr} 0 0 _val)   # LBU
      elseif(_f3 EQUAL 5)
        mem_load(${_addr} 1 0 _val)   # LHU
      else()
        trap_break(2 ${_insn})
      endif()
      wr_rd(${_val})

    elseif(_opcode EQUAL 35) # 0x23 STORE
      math(EXPR _imm "((${_insn} >> 25) << 5) | ((${_insn} >> 7) & 0x1f)")
      if(_imm GREATER 2047)
        math(EXPR _imm "${_imm} - 4096")
      endif()
      math(EXPR _addr "(${_r1} + ${_imm}) & 0xFFFFFFFF")
      if(_f3 GREATER 2)
        trap_break(2 ${_insn})
      endif()
      mem_store(${_addr} ${_r2} ${_f3})

    elseif(_opcode EQUAL 99) # 0x63 BRANCH
      math(EXPR _imm "((${_insn} >> 31) << 12) | (((${_insn} >> 7) & 1) << 11) | (((${_insn} >> 25) & 0x3f) << 5) | (((${_insn} >> 8) & 0xf) << 1)")
      if(_imm GREATER 4095)
        math(EXPR _imm "${_imm} - 8192")
      endif()
      set(_take FALSE)
      if(_f3 EQUAL 0)         # BEQ
        if(${_r1} EQUAL ${_r2})
          set(_take TRUE)
        endif()
      elseif(_f3 EQUAL 1)     # BNE
        if(NOT ${_r1} EQUAL ${_r2})
          set(_take TRUE)
        endif()
      elseif(_f3 EQUAL 4)     # BLT
        to_s32(${_r1} _sa)
        to_s32(${_r2} _sb)
        if(${_sa} LESS ${_sb})
          set(_take TRUE)
        endif()
      elseif(_f3 EQUAL 5)     # BGE
        to_s32(${_r1} _sa)
        to_s32(${_r2} _sb)
        if(NOT ${_sa} LESS ${_sb})
          set(_take TRUE)
        endif()
      elseif(_f3 EQUAL 6)     # BLTU
        if(${_r1} LESS ${_r2})
          set(_take TRUE)
        endif()
      elseif(_f3 EQUAL 7)     # BGEU
        if(NOT ${_r1} LESS ${_r2})
          set(_take TRUE)
        endif()
      else()
        trap_break(2 ${_insn})
      endif()
      if(_take)
        math(EXPR _next "(${_pc} + ${_imm}) & 0xFFFFFFFF")
      endif()

    elseif(_opcode EQUAL 51) # 0x33 OP
      if(_f7 EQUAL 1)
        if(_f3 EQUAL 0)       # MUL
          math(EXPR _res "(${_r1} * (${_r2} & 0xFFFF) + (((${_r1} * (${_r2} >> 16)) & 0xFFFF) << 16)) & 0xFFFFFFFF")
        elseif(_f3 EQUAL 1)   # MULH
          mulhu(${_r1} ${_r2} _res)
          if(${_r1} GREATER 2147483647)
            math(EXPR _res "${_res} - ${_r2}")
          endif()
          if(${_r2} GREATER 2147483647)
            math(EXPR _res "${_res} - ${_r1}")
          endif()
          math(EXPR _res "${_res} & 0xFFFFFFFF")
        elseif(_f3 EQUAL 2)   # MULHSU
          mulhu(${_r1} ${_r2} _res)
          if(${_r1} GREATER 2147483647)
            math(EXPR _res "${_res} - ${_r2}")
          endif()
          math(EXPR _res "${_res} & 0xFFFFFFFF")
        elseif(_f3 EQUAL 3)   # MULHU
          mulhu(${_r1} ${_r2} _res)
        elseif(_f3 EQUAL 4)   # DIV
          to_s32(${_r1} _sa)
          to_s32(${_r2} _sb)
          if(${_sb} EQUAL 0)
            set(_res 4294967295)
          elseif(${_sa} EQUAL ${INT_MIN} AND ${_sb} EQUAL -1)
            set(_res ${_r1})
          else()
            math(EXPR _res "(${_sa} / ${_sb}) & 0xFFFFFFFF")
          endif()
        elseif(_f3 EQUAL 5)   # DIVU
          if(${_r2} EQUAL 0)
            set(_res 4294967295)
          else()
            math(EXPR _res "${_r1} / ${_r2}")
          endif()
        elseif(_f3 EQUAL 6)   # REM
          to_s32(${_r1} _sa)
          to_s32(${_r2} _sb)
          if(${_sb} EQUAL 0)
            set(_res ${_r1})
          elseif(${_sa} EQUAL ${INT_MIN} AND ${_sb} EQUAL -1)
            set(_res 0)
          else()
            math(EXPR _res "(${_sa} % ${_sb}) & 0xFFFFFFFF")
          endif()
        else()                # REMU
          if(${_r2} EQUAL 0)
            set(_res ${_r1})
          else()
            math(EXPR _res "${_r1} % ${_r2}")
          endif()
        endif()
      else()
        math(EXPR _sh "${_r2} & 0x1f")
        if(_f3 EQUAL 0)       # ADD / SUB
          if(_f7 EQUAL 32)
            math(EXPR _res "(${_r1} - ${_r2}) & 0xFFFFFFFF")
          else()
            math(EXPR _res "(${_r1} + ${_r2}) & 0xFFFFFFFF")
          endif()
        elseif(_f3 EQUAL 1)   # SLL
          math(EXPR _res "(${_r1} << ${_sh}) & 0xFFFFFFFF")
        elseif(_f3 EQUAL 2)   # SLT
          to_s32(${_r1} _sa)
          to_s32(${_r2} _sb)
          if(${_sa} LESS ${_sb})
            set(_res 1)
          else()
            set(_res 0)
          endif()
        elseif(_f3 EQUAL 3)   # SLTU
          if(${_r1} LESS ${_r2})
            set(_res 1)
          else()
            set(_res 0)
          endif()
        elseif(_f3 EQUAL 4)   # XOR
          math(EXPR _res "${_r1} ^ ${_r2}")
        elseif(_f3 EQUAL 5)   # SRL / SRA
          if(_f7 EQUAL 32)
            sra32(${_r1} ${_sh} _res)
          else()
            math(EXPR _res "${_r1} >> ${_sh}")
          endif()
        elseif(_f3 EQUAL 6)   # OR
          math(EXPR _res "${_r1} | ${_r2}")
        else()                # AND
          math(EXPR _res "${_r1} & ${_r2}")
        endif()
      endif()
      wr_rd(${_res})

    elseif(_opcode EQUAL 55) # 0x37 LUI
      math(EXPR _res "${_insn} & 0xfffff000")
      wr_rd(${_res})

    elseif(_opcode EQUAL 23) # 0x17 AUIPC
      math(EXPR _res "(${_pc} + (${_insn} & 0xfffff000)) & 0xFFFFFFFF")
      wr_rd(${_res})

    elseif(_opcode EQUAL 111) # 0x6f JAL
      math(EXPR _imm "((${_insn} >> 31) << 20) | (${_insn} & 0xff000) | (((${_insn} >> 20) & 1) << 11) | (((${_insn} >> 21) & 0x3ff) << 1)")
      if(_imm GREATER 1048575)
        math(EXPR _imm "${_imm} - 2097152")
      endif()
      wr_rd(${_next})
      math(EXPR _next "(${_pc} + ${_imm}) & 0xFFFFFFFF")

    elseif(_opcode EQUAL 103) # 0x67 JALR
      if(NOT _f3 EQUAL 0)
        trap_break(2 ${_insn})
      endif()
      dec_imm_i()
      math(EXPR _target "(${_r1} + ${_imm}) & 0xFFFFFFFE")
      wr_rd(${_next})
      set(_next ${_target})

    elseif(_opcode EQUAL 15) # 0x0f FENCE / FENCE.I: no-op

    elseif(_opcode EQUAL 47) # 0x2f RV32A
      if(NOT _f3 EQUAL 2)
        trap_break(2 ${_insn})
      endif()
      math(EXPR _f5 "${_insn} >> 27")
      if(_f5 EQUAL 2)         # LR.W
        mem_load(${_r1} 2 1 _val)
        set(CPU_HAS_RESERVATION TRUE)
        set(CPU_RESERVATION ${_r1})
        wr_rd(${_val})
      elseif(_f5 EQUAL 3)     # SC.W
        if(CPU_HAS_RESERVATION AND CPU_RESERVATION EQUAL ${_r1})
          mem_store(${_r1} ${_r2} 2)
          set(_res 0)
        else()
          set(_res 1)
        endif()
        set(CPU_HAS_RESERVATION FALSE)
        wr_rd(${_res})
      else()                  # AMO*
        mem_load(${_r1} 2 0 _old)
        if(_f5 EQUAL 0)         # AMOADD
          math(EXPR _nv "(${_old} + ${_r2}) & 0xFFFFFFFF")
        elseif(_f5 EQUAL 1)     # AMOSWAP
          set(_nv ${_r2})
        elseif(_f5 EQUAL 4)     # AMOXOR
          math(EXPR _nv "${_old} ^ ${_r2}")
        elseif(_f5 EQUAL 12)    # AMOAND
          math(EXPR _nv "${_old} & ${_r2}")
        elseif(_f5 EQUAL 8)     # AMOOR
          math(EXPR _nv "${_old} | ${_r2}")
        elseif(_f5 EQUAL 16)    # AMOMIN
          to_s32(${_old} _sa)
          to_s32(${_r2} _sb)
          if(${_sa} LESS ${_sb})
            set(_nv ${_old})
          else()
            set(_nv ${_r2})
          endif()
        elseif(_f5 EQUAL 20)    # AMOMAX
          to_s32(${_old} _sa)
          to_s32(${_r2} _sb)
          if(${_sa} GREATER ${_sb})
            set(_nv ${_old})
          else()
            set(_nv ${_r2})
          endif()
        elseif(_f5 EQUAL 24)    # AMOMINU
          if(${_old} LESS ${_r2})
            set(_nv ${_old})
          else()
            set(_nv ${_r2})
          endif()
        elseif(_f5 EQUAL 28)    # AMOMAXU
          if(${_old} GREATER ${_r2})
            set(_nv ${_old})
          else()
            set(_nv ${_r2})
          endif()
        else()
          trap_break(2 ${_insn})
        endif()
        mem_store(${_r1} ${_nv} 2)
        wr_rd(${_old})
      endif()

    elseif(_opcode EQUAL 115) # 0x73 SYSTEM
      if(_f3 EQUAL 0)
        math(EXPR _imm12 "${_insn} >> 20")
        if(_imm12 EQUAL 0)           # ECALL
          if(CPU_PRIV EQUAL 0)
            trap_break(8 0)
          else()
            trap_break(11 0)
          endif()
        elseif(_imm12 EQUAL 1)       # EBREAK
          trap_break(3 ${_pc})
        elseif(_imm12 EQUAL 770)     # 0x302 MRET
          math(EXPR _mpp "(${CPU_MSTATUS} >> 11) & 3")
          math(EXPR CPU_MSTATUS "((${CPU_MSTATUS} & ~((1 << 3) | (3 << 11))) | (((${CPU_MSTATUS} >> 7) & 1) << 3) | (1 << 7) | (${CPU_PRIV} << 11)) & 0xFFFFFFFF")
          set(CPU_PRIV ${_mpp})
          set(_next ${CPU_MEPC})
        elseif(_imm12 EQUAL 261)     # 0x105 WFI: no-op
        else()
          trap_break(2 ${_insn})
        endif()
      else()
        math(EXPR _csr "${_insn} >> 20")
        csr_read(${_csr} _old)
        if(_f3 EQUAL 1)              # CSRRW
          csr_write(${_csr} ${_r1})
        elseif(_f3 EQUAL 2)          # CSRRS
          if(NOT _rs1 EQUAL 0)
            csr_write(${_csr} "${_old} | ${_r1}")
          endif()
        elseif(_f3 EQUAL 3)          # CSRRC
          if(NOT _rs1 EQUAL 0)
            csr_write(${_csr} "${_old} & ~${_r1}")
          endif()
        elseif(_f3 EQUAL 5)          # CSRRWI
          csr_write(${_csr} ${_rs1})
        elseif(_f3 EQUAL 6)          # CSRRSI
          if(NOT _rs1 EQUAL 0)
            csr_write(${_csr} "${_old} | ${_rs1}")
          endif()
        elseif(_f3 EQUAL 7)          # CSRRCI
          if(NOT _rs1 EQUAL 0)
            csr_write(${_csr} "${_old} & ~${_rs1}")
          endif()
        else()
          trap_break(2 ${_insn})
        endif()
        wr_rd(${_old})
      endif()

    else()
      trap_break(2 ${_insn})
    endif()

    set(CPU_PC ${_next})
  endforeach()
endmacro()

message(STATUS "Running")
while(NOT CPU_HALTED)
  math(EXPR CPU_MTIME_LO "(${CPU_MTIME_LO} + 1) & 0xFFFFFFFF")
  if(CPU_MTIME_LO EQUAL 0)
    math(EXPR CPU_MTIME_HI "(${CPU_MTIME_HI} + 1) & 0xFFFFFFFF")
  endif()

  set(EXPIRED FALSE)
  if(CPU_MTIME_HI GREATER CPU_MTIME_CMP_HI OR (CPU_MTIME_HI EQUAL CPU_MTIME_CMP_HI AND CPU_MTIME_LO GREATER_EQUAL CPU_MTIME_CMP_LO))
    set(EXPIRED TRUE)
  endif()

  if(EXPIRED)
    math(EXPR _gie "${CPU_MSTATUS} & 0x8")
    math(EXPR _mtie "${CPU_MIE} & 0x80")
    if(NOT _gie EQUAL 0 AND NOT _mtie EQUAL 0)
      raise_trap(0x80000007 0)
    endif()
  endif()

  if(CPU_HALTED)
    break()
  endif()
  cpu_step()
  math(EXPR CPU_INSTRET "(${CPU_INSTRET} + 1) & 0xFFFFFFFF")

  if(UART_PENDING)
    math(EXPR UART_AGE "${UART_AGE} + 1")
    if(UART_NL OR UART_AGE GREATER ${UART_FLUSH_AGE})
      uart_flush()
    endif()
  endif()
endwhile()

uart_flush()
message(STATUS "Halted: pc=${CPU_PC} instret=${CPU_INSTRET}")
